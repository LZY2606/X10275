[
  {
    "name": "audit: duplicate array elements, same length",
    "before": [1, 2, 2, 3],
    "after": [2, 2, 3, 4],
    "patch": [
      {"op": "replace", "path": "/0", "value": 2},
      {"op": "replace", "path": "/2", "value": 3},
      {"op": "replace", "path": "/3", "value": 4}
    ]
  },
  {
    "name": "audit: duplicate array elements, shrink",
    "before": ["a", "a", "b"],
    "after": ["a", "b"],
    "patch": [
      {"op": "remove", "path": "/2"},
      {"op": "replace", "path": "/1", "value": "b"}
    ]
  },
  {
    "name": "audit: numeric representation difference normalized away",
    "before": {"n": 1},
    "after": {"n": 1.0},
    "patch": []
  },
  {
    "name": "audit: object key reordering produces no operations",
    "before": {"a": 1, "b": 2},
    "after": {"b": 2, "a": 1},
    "patch": []
  },
  {
    "name": "audit: object key order does not affect operation order",
    "before": {"y": 2, "x": 1},
    "after": {"x": 3, "y": 4},
    "patch": [
      {"op": "replace", "path": "/x", "value": 3},
      {"op": "replace", "path": "/y", "value": 4}
    ]
  },
  {
    "name": "audit: root replacement object to array",
    "before": {"a": 1},
    "after": [1, 2],
    "patch": [
      {"op": "add", "path": "", "value": [1, 2]}
    ]
  },
  {
    "name": "audit: root replacement scalar to string",
    "before": 1,
    "after": "one",
    "patch": [
      {"op": "add", "path": "", "value": "one"}
    ]
  }
]
